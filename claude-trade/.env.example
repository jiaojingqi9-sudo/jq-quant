# claude-trade Configuration Example
# 复制此文件为 .env 并填入真实的配置值
# Copy this file to .env and fill in actual configuration values

# ============================================================================
# 通用设置 / General Settings
# ============================================================================

# 初始资本 / Initial capital in USD
INITIAL_CAPITAL=5000

# 单笔交易风险占比 / Risk per trade as percentage of portfolio (0.02 = 2%)
RISK_PER_TRADE_PCT=0.02

# 单个持仓最大占比 / Maximum position size as percentage of portfolio (0.30 = 30%)
MAX_POSITION_PCT=0.30

# 目标年波动率 / Target annual volatility (0.10 = 10%)
TARGET_ANNUAL_VOL=0.10

# ============================================================================
# Futu OpenD 设置 / Futu OpenD Settings
# ============================================================================

# Futu OpenD 服务器地址 / Futu OpenD server host
FUTU_HOST=127.0.0.1

# Futu OpenD 服务器端口 / Futu OpenD server port
FUTU_PORT=11111

# 交易市场 / Trading market (US, HK)
FUTU_TRD_MARKET=US

# 交易环境 / Trading environment (SIMULATE or REAL)
FUTU_TRD_ENV=SIMULATE

# 账户ID / Account ID (留空用模拟账户 / Leave blank for simulator)
# FUTU_ACC_ID=

# 启用真实交易 / Enable real trading (true/false)
FUTU_ENABLE_REAL_TRADING=false

# 允许自动转换为真实交易 / Allow automatic conversion to real trading
FUTU_ALLOW_AUTO_REAL=false

# 交易密码MD5 / Trade password MD5 hash (仅真实交易需要 / Required for real trading)
# FUTU_UNLOCK_TRADE_PASSWORD_MD5=

# 价格缓冲 (基点) / Price buffer in basis points (default 10 bps)
FUTU_PRICE_BUFFER_BPS=10

# 允许盘后交易 / Allow filling orders outside regular trading hours
FUTU_FILL_OUTSIDE_RTH=false

# ============================================================================
# 加密交易所设置 / Crypto Exchange Settings
# ============================================================================

# 交易所 / Exchange (binance, okx)
CRYPTO_EXCHANGE=binance

# API密钥 / API Key
# CRYPTO_API_KEY=

# API密钥密文 / API Secret
# CRYPTO_API_SECRET=

# 密码短语 / Passphrase (某些交易所如OKX需要 / Required for some exchanges like OKX)
# CRYPTO_PASSPHRASE=

# 沙箱模式 / Sandbox mode (true=测试/false=真实 / true=testnet, false=mainnet)
CRYPTO_SANDBOX=true

# ============================================================================
# 自适应双动量策略设置 / Adaptive Dual Momentum Strategy Settings
# ============================================================================

# 交易品种 / Universe (逗号分隔 / comma-separated)
# 美股ETF格式: US.SPY (需要Futu订阅)
# 加密格式: BTC/USDT (CCXT标准)
# US Stock ETF format: US.SPY (requires Futu subscription)
# Crypto format: BTC/USDT (CCXT standard)
DM_UNIVERSE=US.SPY,US.EFA,US.AGG,US.GLD,BTC/USDT,ETH/USDT

# 回溯周期 (月) / Lookback period in months
DM_LOOKBACK_MONTHS=12

# 再平衡日 / Rebalance day (1=每月第一个交易日 / 1=first trading day of month)
DM_REBALANCE_DAY=1

# 绝对收益阈值 / Absolute return threshold (0.0=相对动量 / 0.0=relative momentum)
DM_ABSOLUTE_THRESHOLD=0.0

# 无风险资产 / Risk-free asset for threshold calculation
DM_USE_RISK_FREE=US.AGG

# ============================================================================
# RSI均值回归策略设置 / RSI Mean Reversion Strategy Settings
# ============================================================================

# 交易品种 / Universe (仅加密 / crypto only)
RSI_UNIVERSE=BTC/USDT,ETH/USDT,SOL/USDT

# RSI周期 / RSI period
RSI_PERIOD=14

# 超卖阈值 / Oversold threshold
RSI_OVERSOLD=30

# 超买阈值 / Overbought threshold
RSI_OVERBOUGHT=70

# 时间框架 / Timeframe (1m, 5m, 15m, 1h, 4h, 1d)
RSI_TIMEFRAME=4h

# 成交量过滤 / Volume filter enabled
RSI_VOLUME_FILTER=true

# 趋势过滤周期 / Trend filter period (较长期均线 / longer-term MA)
RSI_TREND_FILTER_PERIOD=200

# ============================================================================
# 波动率突破策略设置 / Volatility Breakout Strategy Settings
# ============================================================================

# 交易品种 / Universe (仅加密 / crypto only)
VB_UNIVERSE=BTC/USDT,ETH/USDT

# K因子 / K-factor (波动率倍数 / volatility multiplier)
VB_K_FACTOR=0.5

# 时间框架 / Timeframe (1h, 4h, 1d)
VB_TIMEFRAME=1d

# ============================================================================
# 策略权重 / Strategy Weights
# ============================================================================

# 双动量权重 / Dual Momentum weight
STRATEGY_DM_WEIGHT=0.50

# RSI均值回归权重 / RSI Mean Reversion weight
STRATEGY_RSI_WEIGHT=0.30

# 波动率突破权重 / Volatility Breakout weight
STRATEGY_VB_WEIGHT=0.20

# ============================================================================
# 自动交易设置 / Auto Trader Settings
# ============================================================================

# 轮询周期 (秒) / Poll interval in seconds
AUTO_TRADER_POLL_SECONDS=60

# 市场时区 / Market timezone (美股 / US stocks)
AUTO_TRADER_MARKET_TIMEZONE=America/New_York

# ============================================================================
# 仪表板设置 / Dashboard Settings
# ============================================================================

# 仪表板端口 / Dashboard port
DASHBOARD_PORT=8051
