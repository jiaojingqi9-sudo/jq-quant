# ── Futu Pre-gate (Fusion Intraday) ─────────────────────────────────────────
# Optional safety filter that can drop Fusion candidate symbols based on the
# already-computed LOB / tick / spread features. Skip-only: it never adds
# symbols, never modifies weights, never modifies orders.
#
# Recommended rollout: leave ENABLED=false on day 1. Flip to true while
# keeping LOG_ONLY=true for a day so you can see what it WOULD have filtered
# in runtime/stock_events.jsonl (search for "fusion_pregate_decision"). Once
# you're happy with the decisions, flip LOG_ONLY=false.
#
# Easier: use the launchers in stock/launchers/ — Pregate_Off / Pregate_LogOnly / Pregate_Active.
FUSION_FUTU_PREGATE_ENABLED=false
FUSION_FUTU_PREGATE_LOG_ONLY=true
FUSION_FUTU_PREGATE_MIN_OB_IMBALANCE=0.20
FUSION_FUTU_PREGATE_MIN_TICK_IMBALANCE=0.15
FUSION_FUTU_PREGATE_MAX_SPREAD_BPS=15.0

OFIM_UNIVERSE=US.AAPL,US.MSFT,US.AMZN,US.GOOG,US.META,US.NVDA,US.TSLA,US.AMD,US.AVGO,US.COIN,US.PLTR,US.MSTR,US.NFLX,US.COST,US.MU
OFIM_BENCHMARK=US.QQQ
OFIM_LOOKBACK_BARS=60
OFIM_DEPTH_TIERS=1-5,6-20,21-60
OFIM_ENTRY_THRESHOLD=0.20
OFIM_EXIT_THRESHOLD=0.05
OFIM_MAX_SCORE=0.60
OFIM_MIN_VOL_ACCELERATION=1.20
OFIM_MAX_SPREAD_BPS=15
OFIM_TICK_WINDOW=100
