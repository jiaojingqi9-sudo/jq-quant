# ── Learning → strategy overrides (human-in-the-loop) ───────────────────────
# When true, config loading applies human-approved parameter overrides that were
# promoted from the learning lab into runtime/promoted_overrides.json
# (see docs/learning_to_strategy_bridge.md). Default false = base .env only.
# Only whitelisted strategy/risk knobs can ever be overridden; safety switches,
# credentials and connection settings can never be. Live trading still requires
# the FUTU_* real-trading switches above.
STRATEGY_OVERRIDES_ENABLED=false
